{
  "name": "gondolaya",
  "version": "2.0.0",
  "description": "GondolaYa — comparador de precios de supermercados argentinos (React + Express)",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:server\" \"npm:client\"",
    "server": "node server.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.11"
  }
}
